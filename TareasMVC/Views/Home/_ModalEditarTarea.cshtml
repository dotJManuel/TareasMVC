<div class="modal fade" id="modal-editar-tarea" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-tarea-titulo" data-bind="text: titulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <button type="button" class="btn btn-secondary btn-sm mb-3"
                        data-bind="visible: tareaPadreId"
                        onclick="manejarClickVolverAlPadre()">
                    <i class="bi bi-arrow-90deg-up"></i> Volver a la tarea principal
                </button>
                <div class="row">
                    <div class="col-lg-9">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="txtTituloCrearTarea"
                                   placeholder="titulo"
                                   autocomplete="off"
                                   data-bind="value: titulo, event: {change: manejarCambioEditarTarea}" />
                            <label for="txtTituloCrearTarea">Título de la tarea</label>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Descripción</label>
                            <textarea type="text" class="form-control" rows="4"
                                      data-bind="value: descripcion,
                                        event: {change: manejarCambioEditarTarea}">

                            </textarea>
                        </div>
                        <div class="mb-4">
                            <partial name="_Pasos" />
                        </div>
                        <div class="mb-4">
                            <partial name="_Subtareas" />
                        </div>
                        <div class="mb-3">
                            <partial name="_ArchivosAdjuntos" />
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <button data-bind="{click: intentarBorrarTarea}"
                                class="btn btn-secondary w-100 text-start btn-block" style="justify-content: flex-start">
                            <i class="bi bi-trash3"></i>
                            Borrar tarea
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>