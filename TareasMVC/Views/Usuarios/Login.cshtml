@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrapper">
    <h1 class="auth-titulo">Bienvenido de nuevo</h1>
    <p class="auth-subtitulo">Inicia sesión para gestionar tus tareas</p>

    @if (ViewData.Keys.Contains("mensaje"))
    {
        <div class="alert alert-danger" role="alert">
            @ViewData["mensaje"]
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="Login">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="Recuerdame" />
                    <label class="form-check-label" asp-for="Recuerdame"></label>
                </div>

                <button class="btn btn-primary btn-block">Iniciar sesión</button>

                <div class="auth-divisor">o</div>

                <div class="auth-acciones">
                    <a class="btn btn-secondary btn-block" asp-action="LoginExterno" asp-route-proveedor="Microsoft">
                        <i class="bi bi-microsoft"></i> Continuar con Microsoft
                    </a>
                    <a class="btn btn-secondary btn-block" asp-action="registro">Crear una nueva cuenta</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
