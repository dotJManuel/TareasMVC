@model RegistroViewModel

@{
    ViewData["Title"] = "Registro";
}

<div class="auth-wrapper">
    <h1 class="auth-titulo">Crea tu cuenta</h1>
    <p class="auth-subtitulo">Empieza a organizar tus tareas en segundos</p>

    <div class="card">
        <div class="card-body">
            <form asp-action="Registro">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button class="btn btn-primary btn-block">Regístrate</button>

                <div class="auth-divisor">o</div>

                <div class="auth-acciones">
                    <a class="btn btn-secondary btn-block" asp-action="LoginExterno" asp-route-proveedor="Microsoft">
                        <i class="bi bi-microsoft"></i> Continuar con Microsoft
                    </a>
                    <a class="btn btn-secondary btn-block" asp-action="login">Ya tengo cuenta</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
