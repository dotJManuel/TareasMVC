@model UsuariosListadoViewModel

@{
    ViewData["Title"] = "Listado de usuarios";
    Layout = "../shared/_layout";
}

<div class="page-header">
    <div>
        <h1>Listado de usuarios</h1>
        <p class="page-subtitle">Gestiona los roles de administrador de la plataforma</p>
    </div>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="alert">
        @Model.Mensaje
    </div>
}

@if (Model.Usuarios is not null)
{

    <form method="post">
        <div class="tabla-card">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <td>Email</td>
                        <td class="text-end">Acción</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @usuario.Email
                            </td>
                            <td class="text-end">
                                <button class="btn btn-primary btn-sm me-2"
                                asp-action="HacerAdmin"
                                asp-route-email="@usuario.Email">
                                    <i class="bi bi-shield-check"></i> Hacer Admin
                                </button>
                                <button class="btn btn-secondary btn-sm"
                                asp-action="RemoverAdmin"
                                asp-route-email="@usuario.Email">
                                    <i class="bi bi-shield-slash"></i> Remover Admin
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>

}
else
{
    <div class="tareas-vacio">
        <i class="bi bi-people"></i>
        No hay usuarios para mostrar
    </div>
}